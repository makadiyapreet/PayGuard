{
  "name": "payguard",
  "version": "1.0.0",
  "description": "Layered payment-integrity bridge system",
  "scripts": {
    "compile": "truffle compile",
    "migrate": "truffle migrate --reset --network ganache",
    "reset": "truffle migrate --reset --network ganache && node scripts/export-frontend-artifacts.js",
    "test": "truffle test --network ganache",
    "demo": "truffle exec scripts/demo.js --network ganache",
    "seed": "truffle exec scripts/seed-demo-state.js --network ganache",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:smoke": "node frontend/scripts/smoke.mjs",
    "attack": "truffle exec scripts/attack.js --network ganache",
    "slither": "slither . --solc-remaps @openzeppelin/=node_modules/@openzeppelin/",
    "dashboard": "node scripts/serve-dashboard.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "truffle-assertions": "^0.9.2"
  }
}
